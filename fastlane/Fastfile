# The listing, and the submission, as files rather than as an afternoon in a web form.
#
# Everything App Store Connect needs lives in `metadata/` and `screenshots/` beside this
# file, which means the listing is reviewable in a pull request and reproducible on the next
# release. The key is the one Codemagic already holds and already uses to upload builds.
#
# Two lanes on purpose. `verify` sends nothing and reports what WOULD be sent; `submit` is
# the irreversible one. Submitting for review is public and cannot be quietly undone, so it
# is never the default and never a side effect of running the other.

default_platform(:ios)

APP = "com.mikejsmith.vbtracker"

platform :ios do
  # The App Store Connect key, built from what the Codemagic integration puts in the
  # environment. Nothing here ever sees the key's contents in a log.
  # The names Codemagic has used for the three halves of the key. More than one, because
  # the integration has not always spelled them the same way, and a KeyError from ENV.fetch
  # says only that something is missing -- not which thing, and not what is there instead.
  KEY_ID_NAMES = %w[APP_STORE_CONNECT_KEY_IDENTIFIER APP_STORE_CONNECT_KEY_ID ASC_KEY_ID].freeze
  ISSUER_NAMES = %w[APP_STORE_CONNECT_ISSUER_ID ASC_ISSUER_ID].freeze
  PRIVATE_KEY_NAMES = %w[APP_STORE_CONNECT_PRIVATE_KEY ASC_PRIVATE_KEY].freeze

  # The first of these names that is actually set. Names only ever appear in a log; values
  # never do.
  def from_env(names, what)
    found = names.find { |name| !ENV[name].to_s.strip.empty? }
    unless found
      present = ENV.keys.grep(/APP_STORE|ASC_|CERTIFICATE/).sort
      UI.user_error!("No #{what} in the environment. Looked for #{names.join(', ')}. Present: #{present.join(', ')}")
    end
    UI.message("Using #{found} for #{what}")
    ENV.fetch(found)
  end

  def connect_key
    app_store_connect_api_key(
      key_id: from_env(KEY_ID_NAMES, "key id"),
      issuer_id: from_env(ISSUER_NAMES, "issuer id"),
      key_content: from_env(PRIVATE_KEY_NAMES, "private key"),
      is_key_content_base64: false,
      in_house: false
    )
  end

  # Settings shared by both lanes, so a dry run cannot differ from the real thing in any
  # way except whether it sends.
  def listing(api_key, extra)
    {
      api_key: api_key,
      app_identifier: APP,
      # The binary is already on App Store Connect: `ios-watch` uploaded it. Uploading it
      # again here would be a second copy of the same build under a number Apple refuses.
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      overwrite_screenshots: true,
      # Held until the operator releases it. An app that goes live the moment a reviewer
      # nods is an app that goes live while nobody is watching.
      automatic_release: false,
      # No prompt, no browser: this runs on a machine with nobody sitting at it.
      force: true,
      run_precheck_before_submit: false,
      submission_information: {
        # There is no encryption in the app at all, and no advertising identifier, and
        # every image in it is ours.
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false,
        content_rights_has_rights: true
      }
    }.merge(extra)
  end

  desc "Report what would be sent to App Store Connect. Sends nothing."
  lane :verify do
    deliver(listing(connect_key, verify_only: true, submit_for_review: false))
    UI.success("Verified. Nothing was sent.")
  end

  desc "Upload the listing and submit the build for review. Irreversible."
  lane :submit do
    deliver(listing(connect_key, verify_only: false, submit_for_review: true))
    UI.success("Submitted for review.")
  end
end
